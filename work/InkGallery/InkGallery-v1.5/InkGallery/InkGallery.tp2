COPY_EXISTING ar1002.are override // Goverment Disctirct - Building of Six
  LPF fj_are_structure INT_VAR
    fj_type = 2 // travel
    fj_box_left = 1309
    fj_box_top = 609
    fj_box_right = 1353
    fj_box_bottom = 717
    fj_cursor_idx = 42
    fj_flags = 1540 // no_NPCs = 512, party_required = save = 4
    fj_alt_x = 1310
    fj_alt_y = 720
    fj_loc_x = 1310
    fj_loc_y = 720
    fj_vertex_0 = 1309 + (686 << 16)
    fj_vertex_1 = 1309 + (609 << 16)
    fj_vertex_2 = 1353 + (638 << 16)
    fj_vertex_3 = 1351 + (717 << 16)
  STR_VAR
    fj_structure_type = region
    fj_name = L#IG_CDOOR
    fj_destination_area = AR1000
    fj_destination_name = L#IG_CE
  END
  LPF fj_are_structure INT_VAR
    fj_loc_x = 1240
    fj_loc_y = 770
    fj_orientation = 1 // facing direction (0-15 where 0=south, 4=west, 8=north, 12=east)*;
  STR_VAR
    fj_structure_type = entrance
    fj_name = L#IGC
  END
  LPF fj_are_structure
    INT_VAR
    fj_loc_x       = 1276
    fj_loc_y       = 735
    fj_flags       = 0b00000000000000000001000101000001
    STR_VAR
    fj_structure_type = animation
    fj_name           = L#IGCBP_E
    fj_bam_resref     = ~L#IGCBP~
  END
  READ_LONG 0xac anim_num
  READ_LONG 0xb0 anim_off
  FOR (index = 0 ; index < anim_num ; ++index) BEGIN 
    READ_ASCII (anim_off + 0x00 + (index * 0x4c)) name
    READ_SHORT (anim_off + 0x20 + (index * 0x4c)) x_coord
    READ_SHORT (anim_off + 0x22 + (index * 0x4c)) y_coord
    PATCH_IF ((x_coord = 1332) AND (y_coord = 632) AND 
              ("%name%" STRING_COMPARE_CASE "FIRE_4" = 0)) BEGIN 
      WRITE_LONG  (anim_off + 0x24 + (index * 0x4c)) 0 // disable at all times
      SET index = anim_num // kill loop
    END
  END
  BUT_ONLY 

COPY_EXISTING AR0069.are override // Goverment Disctirct - Building of Six (CutScene)
  LPF fj_are_structure
    INT_VAR
    fj_loc_x       = 1276
    fj_loc_y       = 735
    fj_flags       = 0b00000000000000000001000101000001
    STR_VAR
    fj_structure_type = animation
    fj_name           = L#IGCBP_E
    fj_bam_resref     = ~L#IGCBP~
  END

// AUDIO

LAF HANDLE_AUDIO END
  
