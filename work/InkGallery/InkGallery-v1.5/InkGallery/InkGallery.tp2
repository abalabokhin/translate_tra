LANGUAGE ~Chinese (by Scarecrow)~
         ~schinese~
         ~InkGallery/languages/schinese/setup.tra~
         
LANGUAGE ~Polish (by my_summertime, SoM Membress, part of CoB Clan)~
         ~polish~
         ~InkGallery/languages/polish/setup.tra~

BEGIN @1
