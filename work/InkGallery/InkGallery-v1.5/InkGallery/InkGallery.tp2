    areaname = EVAL ~AR1000~                            			// area name, e.g. ~AR3700~
  END
  LAF ALTER_SEARCHMAP
    STR_VAR
    path_to_2da_file = EVAL ~%MOD_FOLDER%/area-bmp/AR1002SR_changes.2da~ // full path to the *changes.2da file, e.g. ~mymod/bam/AR3700SR_changes_ee.2da~
