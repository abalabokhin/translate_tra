SetGlobal("L#IGBooksCompleted","GLOBAL",1)
END

IF
Global("L#IGBooksCompleted","GLOBAL",2)
THEN
RESPONSE #100
TriggerActivation("Secretb",TRUE)
PlaySound("L#IGOPE")
DisplayStringHead("Secretb",@155)
SetGlobal("L#IGBooksCompleted","GLOBAL",3)
END
