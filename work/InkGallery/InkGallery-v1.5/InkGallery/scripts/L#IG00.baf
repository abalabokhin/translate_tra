
//BOOK 1

IF
Global("L#IGBook1","GLOBAL",1)
THEN
RESPONSE #100
StartCutScene("L#IGB1S")
END

IF
AreaCheckObject("L#IG00",Player1)
Global("L#IGBook1","GLOBAL",2)
THEN
RESPONSE #100
ActionOverride("L#IGB1",StartDialogueNoSet(Player1))
END

IF
AreaCheckObject("L#IG00",Player1)
Global("L#IGBook1","GLOBAL",3)
THEN
RESPONSE #100
AmbientActivate("BOOKLIGHT1",FALSE)
DisplayStringHead("L#IGSTA",@129)
AddStoreItem("L#IGSTO","L#IGFLA",1,1)
SetGlobal("L#IGBook1","GLOBAL",4)
END

IF
Global("L#IGBook1RewPla1","GLOBAL",1)
THEN
RESPONSE #100
AddXPObject(Player1,5000) 
ApplySpellRES("L#IGB1R",Player1) 
DisplayStringHead(Player1,@130)
SetGlobal("L#IGBook1RewPla1","GLOBAL",2)
END

IF
Global("L#IGBook1RewPla2","GLOBAL",1)
THEN
RESPONSE #100
AddXPObject(Player2,5000) 
