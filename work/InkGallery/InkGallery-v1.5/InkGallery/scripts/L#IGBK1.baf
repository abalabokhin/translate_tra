IF
True()
THEN
RESPONSE #100
    CutSceneId(Player1)
    ClearAllActions()
    StartCutSceneMode()
    DisplayStringHead("BHAALBOOK",@172) 
    Wait(4)
    DisplayStringHead("BHAALBOOK",@173)
    Wait(4)
    ScreenShake([20.20],3)
    Wait(2)
    CreateVisualEffectObject("SPCLOUD1",Player1)
    Wait(1)
    CreateVisualEffectObject("SPFLESHS",Player1)
    Wait(2)
    FadeToColor([20.0],0)
    Wait(1)
    ActionOverride(Player2,MakeUnselectable(999999999))
    ActionOverride(Player3,MakeUnselectable(999999999))
    ActionOverride(Player4,MakeUnselectable(999999999))
    ActionOverride(Player5,MakeUnselectable(999999999))
    ActionOverride(Player6,MakeUnselectable(999999999))
    LeaveAreaLUA("L#IG14","",[740.450],8)
    Wait(1)
    FadeFromColor([20.0],0)
    Wait(2)
    SetGlobal("L#IGBooksCompleted","GLOBAL",8)
    Wait(1)
    MultiPlayerSync()
    EndCutSceneMode()
END