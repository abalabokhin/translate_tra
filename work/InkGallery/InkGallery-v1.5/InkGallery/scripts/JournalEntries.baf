//JOURNAL ENTRIES

IF
Global("L#IGStart","GLOBAL",1)
Global("L#IGJournal","GLOBAL",0)
THEN
RESPONSE #100
AddJournalEntry(@112,QUEST)
SetGlobal("L#IGJournal","GLOBAL",1)
END

