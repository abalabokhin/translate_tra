AddXPObject(Player1,11000)
AddXPObject(Player2,11000)
AddXPObject(Player3,11000)
AddXPObject(Player4,11000)
AddXPObject(Player5,11000)
AddXPObject(Player6,11000)
SetGlobal("L#IGJournalFinal","GLOBAL",1)
END