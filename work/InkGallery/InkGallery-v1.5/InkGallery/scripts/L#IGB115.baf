IF
  True()
THEN
  RESPONSE #100
    CutSceneId(Player5)
    ClearAllActions()
    StartCutSceneMode()
    Wait(2)
    CreateVisualEffectObject("SPCLOUD1",Player5)
    Wait(1)
    CreateVisualEffectObject("SPFLESHS",Player5)
    Wait(2)
    FadeToColor([20.0],0)
    Wait(1)
    LeaveAreaLUA("L#IG11","",[650.400],10)
    Wait(2)
    Explore()
    FadeFromColor([20.0],0)
    SmallWait(4)
    CreateVisualEffectObject("SPCLOUD1",Player5)
    Wait(1)
    CreateVisualEffectObject("SPFLESHS",Player5)
    ActionOverride(Player1,MakeUnselectable(999999999))
    ActionOverride(Player2,MakeUnselectable(999999999))
    ActionOverride(Player3,MakeUnselectable(999999999))
    ActionOverride(Player4,MakeUnselectable(999999999))
    ActionOverride(Player6,MakeUnselectable(999999999))
    Wait(2)
    SetGlobal("L#IGBook11","GLOBAL",2)
    Wait(1)
    MultiPlayerSync()
    EndCutSceneMode()
END