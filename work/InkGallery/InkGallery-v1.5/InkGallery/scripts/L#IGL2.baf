IF
	Clicked([ANYONE])
	Range(LastTrigger,10)
THEN
	RESPONSE #100
		ClearAllActions()
		SmallWait(5)
		StartCutSceneMode()
		MoveViewObject(LastTrigger,INSTANT)
		Wait(2)
    CreateVisualEffectObject("SPCLOUD1",LastTrigger)
    Wait(1)
    CreateVisualEffectObject("SPFLESHS",LastTrigger)
		Wait(2)
		FadeToColor([30.0],0)
		Wait(2)
		CopyGroundPilesTo("L#IG00",[670.325])
    ActionOverride(LastTrigger,LeaveAreaLUA("L#IG00","",[530.430],0))
    ActionOverride(Player1,MakeUnselectable(0))
    ActionOverride(Player2,MakeUnselectable(0))
    ActionOverride(Player3,MakeUnselectable(0))
    ActionOverride(Player4,MakeUnselectable(0))
    ActionOverride(Player5,MakeUnselectable(0))
    ActionOverride(Player6,MakeUnselectable(0))
		ActionOverride(LastTrigger,Wait(2))
		ActionOverride(LastTrigger,MultiPlayerSync())
		ActionOverride(LastTrigger,FadeFromColor([30.0],0))
		Wait(2)
		CreateVisualEffectObject("SPCLOUD1",LastTrigger)
		SetGlobal("L#IGBook9Finished","GLOBAL",1)
    Wait(1)
		ActionOverride(LastTrigger,EndCutSceneMode())
END