IF
Global("L#IGBook11RewPla1","GLOBAL",1)
Global("L#IGInnitialAttack10","LOCALS",0)
THEN
RESPONSE #100
SetGlobal("L#IGInnitialAttack10","LOCALS",1)
Attack(Player1)
END

