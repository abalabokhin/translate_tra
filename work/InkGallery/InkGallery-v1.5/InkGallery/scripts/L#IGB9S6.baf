IF
  True()
THEN
  RESPONSE #100
    CutSceneId(Player6)
    ClearAllActions()
    StartCutSceneMode()
    Wait(2)
    CreateVisualEffectObject("SPCLOUD1",Player6)
    Wait(1)
    CreateVisualEffectObject("SPFLESHS",Player6)
    Wait(2)
    FadeToColor([20.0],0)
    Wait(1)
    LeaveAreaLUA("L#IG09","",[685.530],10)
    Wait(2)
    Explore()
    FadeFromColor([20.0],0)
    SmallWait(4)
    CreateVisualEffectObject("SPCLOUD1",Player6)
    Wait(1)
    CreateVisualEffectObject("SPFLESHS",Player6)
    ActionOverride(Player1,MakeUnselectable(999999999))
    ActionOverride(Player2,MakeUnselectable(999999999))
    ActionOverride(Player3,MakeUnselectable(999999999))
    ActionOverride(Player4,MakeUnselectable(999999999))
    ActionOverride(Player5,MakeUnselectable(999999999))
    Wait(2)
    SetGlobal("L#IGBook9","GLOBAL",2)
    Wait(1)
    MultiPlayerSync()
    EndCutSceneMode()
END