IF
Dead("L#IGB9E")
Global("L#IGActivateExit","L#IG09",0)
THEN 
RESPONSE #100
TriggerActivation("Leave",TRUE)
AmbientActivate("Leaveani",TRUE)
DisplayStringHead("LEAVE",@164)
SetGlobal("L#IGActivateExit","L#IG09",1)
END