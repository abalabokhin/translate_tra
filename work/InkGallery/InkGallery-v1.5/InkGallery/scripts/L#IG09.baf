

//dead magic

IF
	!GlobalTimerNotExpired("AntimagicTimer","L#IG09")  
	Global("L#IGBook9RewPla1","GLOBAL",1)
THEN
	RESPONSE #100
		ApplySpell(Player1,DEAD_MAGIC_AREA)  
		SetGlobalTimer("AntimagicTimer","L#IG09",14)  
END

