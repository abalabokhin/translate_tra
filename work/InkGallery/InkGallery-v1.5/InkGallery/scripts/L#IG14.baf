IF
Global("L#IGCosmicScene","GLOBAL",0)
THEN
RESPONSE #100
CreateCreature("L#IGCS1",[740.250],0)
SmallWait(1)
ActionOverride("L#IGCS1",DialogueInterrupt(FALSE))
CreateVisualEffectObject("SPFLESHS","L#IGCS1")
SetGlobal("L#IGCosmicScene","GLOBAL",1)
END

