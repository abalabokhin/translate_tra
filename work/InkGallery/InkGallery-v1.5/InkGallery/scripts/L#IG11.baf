IF
NumDead("L#IGB11E",32)
Global("L#IGActivateExit","L#IG11",0)
THEN 
RESPONSE #100
TriggerActivation("Leave",TRUE)
AmbientActivate("Leaveani",TRUE)
DisplayStringHead("LEAVE",@167)
SetGlobal("L#IGActivateExit","L#IG11",1)
END

IF
Global("L#IGB11Swarms","GLOBAL",0)
THEN
RESPONSE #100
SetGlobalTimer("L#IGB11SwarmsTime","GLOBAL",6)
SetGlobal("L#IGB11Swarms","GLOBAL",1)
CreateCreature("L#IGB11E",[950.150],2)
CreateCreature("L#IGB11E",[1010.170],2)
CreateCreature("L#IGB11E",[100.750],9)
CreateCreature("L#IGB11E",[150.780],9)
CreateCreature("L#IGB11E",[370.800],8)
CreateCreature("L#IGB11E",[1160.300],5)
CreateCreature("L#IGB11E",[830.580],8)
END

