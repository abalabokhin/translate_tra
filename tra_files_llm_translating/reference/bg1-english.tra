@13958 = ~Easy~
@13959 = ~Hard~
@13960 = ~Well, that was pathetic, but then, men are the weaker sex. Thanks for the easy cash.~
@13961 = ~You're the most sickly group of adventurers I've ever laid eyes on. Get out of my sight before I throw up.~
