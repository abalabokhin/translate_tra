@23912 = ~[CLAIR 03] Fight! And I will speed your death!~ [CLDEL_03]
@23913 = ~[CLAIR 04] I'll not let this place take me.~ [CLDEL_04]
@23914 = ~[CLAIR 05] ~ [CLDEL_05]
