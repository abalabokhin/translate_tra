@23844 = ~[MENDAS 01] I must be speaking to you. Listen, please.~ [MENDA_01]
@23845 = ~[MENDAS 02] ~
@23846 = ~[MENDAS 03] You have cost your life! You die!~ [MENDA_03]
@23847 = ~[MENDAS 04] I have waited long for such as you.~ [MENDA_04]
