@16241 = ~[Main Male 18] Yes?~ [Mainm18]
@16242 = ~[Main Male 19] I stand ready.~ [Mainm19]
@16243 = ~[Main Male 20] It will be done.~ [Mainm20]
@16244 = ~[MAIN MALE 21] Not a problem.~ [Mainm21]
@16245 = ~[MAIN MALE 22] With ease.~ [Mainm22]
