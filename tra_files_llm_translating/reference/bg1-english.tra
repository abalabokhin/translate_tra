@23947 = ~[VILLAGER, MALE 01d] You are not like us.~ [VILLM01d]
@23948 = ~[VILLAGER, MALE 01e] Some will not trust you... some like me.~ [VILLM01e]
@23949 = ~[VILLAGER, MALE 01f] I say my mind: Go as soon as you can.~ [VILLM01f]
