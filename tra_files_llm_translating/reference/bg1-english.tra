@5643  = ~[BEAR, POLAR 01]~ [PBEAR01]
@5644  = ~[BEAR, POLAR 02]~ [PBEAR02]
@5645  = ~[BEAR, POLAR 03]~ [PBEAR03]
@5646  = ~[GHOUL 03]~ [GHOUL03]
@5647  = ~[BEAR, POLAR 04]~ [PBEAR04]
