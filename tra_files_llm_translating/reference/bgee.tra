@17119 = ~Повышение уровня~ [GAM_11]
@17120 = ~Скрыться в тенях не удалось~
@17121 = ~~ [AMB_E42C]
@17122 = ~Автопауза отключена~
@17123 = ~Главный персонаж погиб.~
@17124 = ~Охотник за головами~
@17125 = ~Охотник за головами~
@17126 = ~Графика~
@17127 = ~Звук~
