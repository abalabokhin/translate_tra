@25407 = ~На себя~
@25408 = ~Заклинание направляется на самого заклинателя.~
@25409 = ~Последний атаковавший~
@25410 = ~Заклинание направляется на того, кто атаковал заклинателя последним.~
@25411 = ~Ближайший враг~
@25412 = ~Заклинание направляется на ближайшего врага.~
@25413 = ~Попадание~
@25414 = ~Когда любое существо наносит урон заклинателю.~
@25415 = ~Враг в поле зрения~
@25416 = ~Заклинатель видит врага.~
@25417 = ~50% здоровья~
@25418 = ~Показатель пунктов здоровья заклинателя снижается до 50% от максимума.~
@25419 = ~25% здоровья~
@25420 = ~Показатель пунктов здоровья заклинателя снижается до 25% от максимума.~
@25421 = ~10% здоровья~
@25422 = ~Показатель пунктов здоровья заклинателя снижается до 10% от максимума.~
@25423 = ~Беспомощность~
@25424 = ~Когда заклинатель приведён в беспомощное состояние (находится под воздействием очарования, подчинения, замешательства, ошеломления, усыпления и т.д.).~
@25425 = ~Отравление~
@25426 = ~Когда заклинатель подвергается отравлению.~
