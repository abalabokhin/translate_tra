@12705 = ~Бентан~
@12706 = ~Чёрная Лили~
@12707 = ~Брандилар~
@12708 = ~Служитель Гонда Братлен~
@12709 = ~Кассон Белде'ар~
@12710 = ~Даброн Сашенстар~
@12711 = ~Деаган~
@12712 = ~Делсвирфтанион~
@12713 = ~Делтир~
