IF
Dead("L#IGB2E1")
CombatCounter(0)
Global("L#IGTimeForSecondEnemy","L#IG02",0)
THEN 
RESPONSE #100
StartCutSceneMode()
Wait(1)
FadeToColor([20.0],0)
Wait(1)
JumpToPoint([685.530])
ActionOverride(Player2,JumpToPoint([595.580]))
ActionOverride(Player3,JumpToPoint([560.490]))
ActionOverride(Player4,JumpToPoint([620.620]))
ActionOverride(Player5,JumpToPoint([500.570]))
ActionOverride(Player6,JumpToPoint([505.640]))
CreateCreature("L#IGB2E2",[931.392],2)
Wait(1)
FadeFromColor([20.0],0)
Wait(1)
SetGlobal("L#IGTimeForSecondEnemy","L#IG02",1)
SetGlobal("L#IGB2E2Start","GLOBAL",1)
Wait(1)
MultiPlayerSync()
EndCutSceneMode()
END

IF
Dead("L#IGB2E1")
CombatCounter(0)
Global("L#IGB2E2Died","GLOBAL",1)
Global("L#IGActivateExit","L#IG02",0)
THEN 
RESPONSE #100
TriggerActivation("Leave",TRUE)
AmbientActivate("Leaveani",TRUE)
DisplayStringHead(Player1,@157)
SetGlobal("L#IGActivateExit","L#IG02",1)
END